        ctrl: { outputRaw: 38.0, lastTargetTs: 0, lastUpdate: nowMs(), gapBoostC: 0, gapBoostHoldUntil: 0 },
        thermal: { watertank: 55.0, outdoor: 10.0 },
        sensors: {
            sunlight: 500,
            returnWaterTemp: 30,
            mixedWaterTemp: 35.0,
            outputWaterTemp: 35,
            waterFlowM3h: 0.0,
            deltaT_supply_return: 0.0,
            heatPowerObsKw: 0.0,
            heatPowerEmaKw: 0.0,
